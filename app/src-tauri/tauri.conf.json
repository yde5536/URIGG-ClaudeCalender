{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoworkCalendar",
  "version": "0.1.2",
  "identifier": "com.personal.coworkcalendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "코워크 캘린더",
        "width": 360,
        "height": 560,
        "minWidth": 260,
        "minHeight": 320,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCODZCNzczRDY3MzY2QjMKUldTelpuUFdjN2VHbTdqTHlQV2thRFN2OTlpWEU1TWZEZ3g1YkJ2eGtLZFBkVkVkYjlXUVVMbVUK",
      "endpoints": ["https://github.com/yde5536/URIGG-ClaudeCalender/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
